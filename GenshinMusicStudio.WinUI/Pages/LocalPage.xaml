<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GenshinMusicStudio_WinUI.Pages.LocalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24,18,24,24" Spacing="14">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="本地文件" />
            <TextBlock Text="直接处理本地音频、视频或 MIDI 文件。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="输入与输出" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="输入文件" VerticalAlignment="Center" />
                        <TextBox x:Name="InputBox" Grid.Column="1" PlaceholderText="音频 / 视频 / MIDI" />
                        <Button Grid.Column="2" Content="选择文件" Click="BrowseInput_Click" />
                        <TextBlock Grid.Row="1" Text="输出文件夹（默认与输入同目录）" VerticalAlignment="Center" />
                        <TextBox x:Name="OutputBox" Grid.Row="1" Grid.Column="1" />
                        <Button Grid.Row="1" Grid.Column="2" Content="选择" Click="BrowseOutput_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="转换选项" FontWeight="SemiBold" />
                    <CheckBox x:Name="MelodyBox" Content="只保留主旋律" IsChecked="True" />
                    <CheckBox x:Name="PreserveBox" Content="保持原曲时长" IsChecked="True" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                        <TextBlock Text="最短按键间隔 (ms)" VerticalAlignment="Center" />
                        <NumberBox x:Name="MinGapBox" Grid.Column="1" Value="60" Minimum="20" Maximum="200" SpinButtonPlacementMode="Compact" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="8" RowSpacing="6" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Name="FullButton" Content="提取音频 + AI扒谱 + 转换" Style="{StaticResource AccentButtonStyle}" Click="Full_Click" />
                    <Button x:Name="TranscribeButton" Grid.Column="1" Content="仅 AI 扒谱" Click="Transcribe_Click" />
                    <Button x:Name="MidiButton" Grid.Column="2" Content="仅 MIDI 转换" Click="Midi_Click" />
                    <TextBlock Grid.Column="4" Text="AI 模型" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <ComboBox x:Name="ModelBox" Grid.Column="5" SelectedIndex="0" HorizontalAlignment="Stretch" ToolTipService.ToolTip="选择 AI 扒谱模型" SelectionChanged="ModelBox_SelectionChanged">
                        <ComboBoxItem Content="Basic Pitch ONNX（原生复音）" Tag="basic_pitch_onnx" />
                        <ComboBoxItem Content="Basic Pitch Python（复音）" Tag="basic_pitch_python" />
                        <ComboBoxItem Content="Piano Transcription（钢琴专用）" Tag="piano_transcription" />
                        <ComboBoxItem Content="Demucs 人声 + Basic Pitch" Tag="demucs_vocals_basic" />
                        <ComboBoxItem Content="Demucs 伴奏 + Piano" Tag="demucs_accompaniment_piano" />
                        <ComboBoxItem Content="Demucs 人声 + CREPE" Tag="demucs_vocals_crepe" />
                        <ComboBoxItem Content="CREPE 单音旋律" Tag="crepe" />
                        <ComboBoxItem Content="librosa pyin（主旋律）" Tag="librosa_pyin" />
                    </ComboBox>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="模型状态" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="ModelStatusText" Text="检测中..." VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
