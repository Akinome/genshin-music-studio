<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GenshinMusicStudio_WinUI.Pages.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24,18,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="演奏" />
            <TextBlock Text="点击琴键或使用电脑键盘弹奏（QWERTYU / ASDFGHJ / ZXCVBNM）。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="乐器" VerticalAlignment="Center" />
            <ComboBox x:Name="AudioBox" Width="180" SelectionChanged="AudioBox_SelectionChanged" />
            <FontIcon Glyph="&#xE767;" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text="音量" VerticalAlignment="Center" />
            <Slider x:Name="VolumeSlider" Width="180" Minimum="0" Maximum="100" ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock x:Name="VolumeText" Text="90%" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
            <Grid x:Name="KeyboardViewport" />
        </Border>
    </Grid>
</Page>
