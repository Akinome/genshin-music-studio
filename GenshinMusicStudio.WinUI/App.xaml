<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="GenshinMusicStudio_WinUI.App"
    RequestedTheme="Dark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GenshinMusicStudio_WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#151518" />
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#1B1B1F" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#202024" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2A2A2F" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#3A3A40" />
                    <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#EEF1F5" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#DDE1E7" />
                    <SolidColorBrush x:Key="AccentBlueBrush" Color="#2563EB" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
