<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="GenshinMusicStudio_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GenshinMusicStudio_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="原神音乐工作台"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" MinHeight="0" />
            <RowDefinition x:Name="BottomPanelRow" Height="300" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="{ThemeResource PaneBackgroundBrush}" Padding="12,0,150,0"
              SizeChanged="AppTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="Assets/Square44x44Logo.scale-200.png" Width="20" Height="20" />
                <TextBlock Text="原神音乐工作台" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0">
                <ToggleButton x:Name="ThemeToggleButton" Width="40" Height="32" Padding="0" IsChecked="True"
                              Click="ThemeToggle_Click" ToolTipService.ToolTip="切换深浅主题">
                    <FontIcon Glyph="&#xE706;" FontSize="14" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            OpenPaneLength="160"
            CompactPaneLength="48"
            IsPaneToggleButtonVisible="True"
            Background="{ThemeResource PaneBackgroundBrush}"
            MinHeight="0"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="链接一键处理" IsSelected="True" Tag="download">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="本地文件" Tag="local">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="谱库" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="environment">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Border Margin="8,8,12,8" Padding="4" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <Frame x:Name="NavFrame" MinHeight="0" />
            </Border>
        </NavigationView>

        <Border Grid.Row="2" Margin="8,0,12,8" Padding="14,10,14,12" CornerRadius="12"
                BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"
                Background="{ThemeResource PanelBackgroundBrush}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ProgressBar x:Name="RunProgress" Height="6" Minimum="0" Maximum="100" Value="0"
                             Foreground="{ThemeResource AccentBlueBrush}" />

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="就绪" />
                    <Button x:Name="StopButton" Grid.Column="1" Content="停止" IsEnabled="False" Click="Stop_Click"
                            Background="#B91C1C" Foreground="White" />
                </Grid>

                <Button x:Name="LogToggleButton" Grid.Row="2" Content="收起运行日志"
                        Click="LogToggle_Click" HorizontalAlignment="Left" Margin="0,4,0,4" />

                <TextBox x:Name="LogBox" Grid.Row="3" Height="190" MinHeight="120" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" FontFamily="Consolas" HorizontalAlignment="Stretch"
                         Background="#111114" Foreground="#DCE6F5" BorderBrush="{ThemeResource CardStrokeBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
