<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GenshinMusicStudio_WinUI.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24,18,24,24" Spacing="14">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="播放" />
            <TextBlock Text="选择 MIDI 文件，查看钢琴卷帘并播放。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="FilePathBox" PlaceholderText="MIDI 文件路径" />
                    <Button Grid.Column="1" Content="选择" Click="Browse_Click" />
                    <Button Grid.Column="2" Content="打开位置" Click="OpenFileLocation_Click" />
                </Grid>
            </Border>

            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <ScrollViewer x:Name="RollScroll" Height="380" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="RollCanvas" Width="1200" Height="344" />
                </ScrollViewer>
            </Border>

            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Click="Play_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" />
                                <TextBlock x:Name="PlayText" Text="播放" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71A;" />
                                <TextBlock Text="停止" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="TimeText" Text="0:00 / 0:00" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="NowPlayingText" Text="" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>
                    <ProgressBar x:Name="PlayProgress" Minimum="0" Maximum="100" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE767;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="音量" VerticalAlignment="Center" />
                        <Slider x:Name="VolumeSlider" Width="200" Minimum="0" Maximum="100" ValueChanged="VolumeSlider_ValueChanged" />
                        <TextBlock x:Name="VolumeText" Text="90%" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="音符力度" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <Slider x:Name="BoostSlider" Width="200" Minimum="0" Maximum="300" Value="150" ValueChanged="BoostSlider_ValueChanged" />
                        <TextBlock x:Name="BoostText" Text="150%" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
