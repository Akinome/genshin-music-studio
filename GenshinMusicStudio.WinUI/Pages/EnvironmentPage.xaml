<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GenshinMusicStudio_WinUI.Pages.EnvironmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24,18,24,24" Spacing="14">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="环境与安装" />
            <TextBlock Text="查看下载器和 AI 扒谱依赖，或通过 uv 安装独立 Python 环境。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="依赖状态" FontWeight="SemiBold" />
                    <StackPanel x:Name="DependencyPanel" Spacing="6" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="模型状态" FontWeight="SemiBold" />
                    <StackPanel x:Name="ModelPanel" Spacing="6" />
                    <TextBlock Text="选择要安装的模型组" FontWeight="SemiBold" />
                    <CheckBox x:Name="InstallBasicBox" Content="基础组（yt-dlp、librosa、soundfile）" IsChecked="True" />
                    <CheckBox x:Name="InstallPianoBox" Content="钢琴组（Piano Transcription，含 PyTorch）" IsChecked="True" />
                    <CheckBox x:Name="InstallDemucsBox" Content="Demucs 组（人声/伴奏分离，含 PyTorch）" IsChecked="True" />
                    <CheckBox x:Name="InstallCrepeBox" Content="CREPE 组（单音旋律，含 PyTorch）" IsChecked="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RefreshButton" Content="重新检测" Click="Refresh_Click" />
                        <Button x:Name="InstallButton" Content="使用 uv 安装/更新 AI 环境" Style="{StaticResource AccentButtonStyle}" Click="Install_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="AI 环境说明" FontWeight="SemiBold" />
                    <TextBlock Text="推荐使用 uv 创建 Python 3.11 独立环境。基础复音扒谱使用内置 ONNX 模型，librosa 作为内置旋律兜底。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="CommandBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" Height="90"
                             Text="uv venv --python 3.11 .venv-ai&#x0a;uv pip install --python .venv-ai\Scripts\python.exe -U yt-dlp librosa soundfile &quot;setuptools&lt;81&quot;&#x0a;uv pip install --python .venv-ai\Scripts\python.exe torch torchaudio --index-url https://download.pytorch.org/whl/cpu&#x0a;uv pip install --python .venv-ai\Scripts\python.exe piano_transcription_inference demucs torchcrepe" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
